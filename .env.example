# Copy to .env and replace every "change-me". Generate secrets with:
#   openssl rand -hex 24

# Public domain served by Caddy (production only).
DOMAIN=test.operium.pro
MB_SITE_URL=https://test.operium.pro

# Flows send this in the x-api-key header.
API_KEY=change-me

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me
MONGO_API_PASSWORD=change-me
MONGO_METABASE_PASSWORD=change-me

# Metabase's own settings database (Postgres)
MB_DB_PASSWORD=change-me

# First Metabase admin, created by metabase-setup
MB_ADMIN_EMAIL=admin@operium.pro
MB_ADMIN_PASSWORD=change-me-too-at-least-8-chars
MB_SITE_NAME=Operium Insights

# Give the dashboard a public, view-only link (handy for demos).
PUBLIC_DASHBOARD=true
